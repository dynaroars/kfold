1.o	built-in	(CONFIG_1=y || (CONFIG_1=n && CONFIG_A=y))
2.o	built-in	(CONFIG_2=y && CONFIG_A=n)
3.o	built-in	(CONFIG_A=y || (CONFIG_A=n && CONFIG_B=y))
4.o	built-in	CONFIG_C=y
probe.o	built-in	CONFIG_B=n
probe0.o	built-in	(CONFIG_A=y && CONFIG_B=y)
probe32.o	built-in	CONFIG_A=y
probe64.o	built-in	CONFIG_A=n
probey.o	built-in	CONFIG_B=y
scan.o	built-in	true
