# CONFIG_WDT_SP805 is not set
# CONFIG_WDT_STM32MP is not set
# CONFIG_WDT_STARFIVE is not set
# CONFIG_XILINX_TB_WATCHDOG is not set
CONFIG_WDT_FTWDT010=y
