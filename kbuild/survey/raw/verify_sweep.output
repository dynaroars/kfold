              {
                "url": "https://www.mail-archive.com/barebox@lists.infradead.org/msg52434.html",
                "opened": true,
                "note": "Cover letter 'one-liner fix remaining' and 'seize the opportunity' are Fatoum's; the reply from Hauer is 'Applied, thanks!'.",
                "quote_verbatim": true
              },
              {
                "url": "https://docs.kernel.org/process/maintainer-netdev.html",
