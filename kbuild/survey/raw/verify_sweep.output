              "quote": "M002: composite module 'snd-soc-tegra-utils' defined but not in any obj-*",
              "url": "https://github.com/torvalds/linux/commit/dad701bdb74368e6da30177b1d9e5529e3381591.patch",
              "date": "2026-04-25",
