              {
                "url": "https://lwn.net/Articles/1034811/",
                "opened": true,
                "note": "Daroc Alden 2025-09-10; 32,468 options and the 'hard to tell exactly how many configurations are being covered' quote verified; Kmax folded into 0-day.",
                "quote_verbatim": true
              },
              {
                "url": "https://speakerdeck.com/ennael/large-scale-kernel-build-testing-on-a-desktop",
                "opened": true,
                "note": "Bergmann deck dated 2026-09-28 on Speaker Deck (Kernel Recipes account); '15 years' and 'thousands of bugfixes' verified; no event named; no coverage data.",
