            },
            {
              "claim": "Maintainers Summit 2022 (LWN): Torvalds said linux-next testing does not reach drivers; Mark Brown added that testers do not know what subsystem maintainers test. Separate session from the 2025 one.",
              "quote": "doesn't really cover drivers",
              "url": "https://lwn.net/Articles/908324/",
              "date": "2022-09-19",
              "evidence_type": "anecdote",
