              "reopened_and_verified": true
            },
            {
              "claim": "Kernel-tree KernelSBOM, which needs a successful build, deliberately does not parse Makefiles or Kbuild. Build-based provenance and static build conditions are therefore complementary.",
              "quote": "Parsing these files is considered too complex for the scope of this project.",
              "url": "https://kernel.org/doc/html/latest/tools/sbom/sbom.html",
