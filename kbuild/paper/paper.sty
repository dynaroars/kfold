% Shared preamble for paper.tex (PLDI 2027 / acmart, acmsmall).
% Loaded via \usepackage{paper}.

\AtBeginDocument{%
  \providecommand\BibTeX{{Bib\TeX}}}

\usepackage{amsmath}
% do not load amssymb or amsthm: acmart provides them (amssymb would clash on \Bbbk).
\usepackage{booktabs}
\usepackage{tabularx}
\usepackage{xcolor}
\usepackage{xspace}
\usepackage{enumitem}
\usepackage[linesnumbered,ruled,vlined,norelsize,noend]{algorithm2e}
\SetAlgorithmName{Alg.}{Algorithm}{List of Algorithms}
\SetAlgoCaptionSeparator{.}
% generated table bodies (table/xxx.tex); \@@input avoids the file hooks of \input,
% which break the last row of a tabular before \bottomrule
\makeatletter\newcommand{\tablebody}[1]{\@@input table/#1.tex }\makeatother
\usepackage{listings}
\lstdefinelanguage{kbuild}{
  morekeywords={ifeq,ifneq,ifdef,ifndef,else,endif,include},
  morecomment=[l]{\#}, sensitive=true}
\lstdefinestyle{kbuild}{language=kbuild, basicstyle=\ttfamily\footnotesize,
  keywordstyle=\bfseries, commentstyle=\itshape, numbers=left,
  numberstyle=\tiny, numbersep=6pt, xleftmargin=1.5em, columns=fullflexible,
  keepspaces=true, showstringspaces=false}
\usepackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc}
\usepackage{subcaption}
\renewcommand{\thesubfigure}{(\alph{subfigure})}
\captionsetup[sub]{labelformat=simple}
\providecommand*{\subfigureautorefname}{Figure}

% acmart numbers definitions with the theorem counter; alias the counter so
% \autoref prints "Definition N" (same fix as the FSE 2027 orbit paper).
\usepackage{aliascnt}
\theoremstyle{acmplain}
\newtheorem{theorem}{Theorem}[section]
\theoremstyle{acmdefinition}
\newaliascnt{definition}{theorem}
\newtheorem{definition}[definition]{Definition}
\aliascntresetthe{definition}
\theoremstyle{acmplain}
\newaliascnt{proposition}{theorem}
\newtheorem{proposition}[proposition]{Proposition}
\aliascntresetthe{proposition}
\theoremstyle{acmplain}
\providecommand*{\definitionautorefname}{Definition}
\providecommand*{\theoremautorefname}{Theorem}



% Macros
\newcommand{\tool}{\textsc{kfold}}
\newcommand{\eg}{\emph{e.g.}}
\newcommand{\placeholder}{\textcolor{red}{placeholder: add later}}

% Comments (set usecomment to true while drafting)
\usepackage{etoolbox}
\newtoggle{usecomment}
\newcommand{\tl}[1]{\iftoggle{usecomment}{{\color{blue!60!black}{[TL]: #1}}}{}}
\newcommand{\hd}[1]{\iftoggle{usecomment}{{\color{blue!40!cyan}{[HD]: #1}}}{}}
\newcommand{\tvn}[1]{\iftoggle{usecomment}{{\color{red}{[TVN]: #1}}}{}}
\settoggle{usecomment}{false}

